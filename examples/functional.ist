SelfSystem("pause");

iFor<<i;
FourByte(8000);
{;
	PrintFlush();
	PrintNewLine();

	CallExcTop("else");
	CallExcTop("buzz");
	CallExcTop(); //if used without a string inside it, it will access the item at the top of the stack [which for our purpouses is String("fizz")] and use that to find the function it should be exacuting
	String("fizz");

	SelfPrint(": ");
	PopPrint();
	#i>>str;

	&FourByte<<;

	i+;
	FourByte(1);
};


Fn("fizz");
{;
	If;
	i==;
	FourByte(0);
	i%;
	&Swap<<;
	FourByte(3);
	{;
		PrintFlush();
		SelfPrint("fizz");
	};
};

Fn("buzz");
{;
	If;
	i==;
	FourByte(0);
	i%;
	&Swap<<;
	FourByte(5);
	{;
		PrintFlush();
		SelfPrint("buzz");
	};
};

Fn("else");
{;
	If;
	Not;
	i==;
	FourByte(0);
	i%;
	&Swap<<;
	FourByte(3);
	PushDataIntoScope();
	{;
		If;
		Not;
		i==;
		FourByte(0);
		i%;
		&Swap<<;
		FourByte(5);
		PushDataIntoScope();
		{;
			//PrintFlush();
			PopPrint();
			#i>>str;
		};
		
		&FourByte<<;
	};
	
	&FourByte<<;
};