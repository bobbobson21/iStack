
While<<i;
{;
    PrintNewLine();
    
    If;
    CanCallFn();
    PushDataIntoScope();
    {;
        Call();
    };

    &String<<;
    Input();
    SelfPrint("input oparation: ");
};


Fn("+");
{;
    PrintNewLine();
    PopPrint();
    #i>>str;
    i+;

    #str>>i;
    Input();
    SelfPrint("input oparad: ");
	
	#str>>i;
    Input();
    SelfPrint("input oparad: ");
};

